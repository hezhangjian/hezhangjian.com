{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "name": "hezhangjian-com",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
}
