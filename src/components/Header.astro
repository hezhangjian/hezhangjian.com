---
import SocialLinks from './SocialLinks.astro';
---

<header>
  <a href="/">
    <img src="/images/avatar.png" alt="" width="40" height="40" />
    <span>Zhangjian He</span>
  </a>
  <SocialLinks />
</header>

<style>
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    min-height: 80px;
    padding: 0 clamp(20px, 4.5vw, 72px);
    border-bottom: 1px solid #e0e4ea;
  }

  a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: inherit;
    font-size: 21px;
    font-weight: 700;
    letter-spacing: -0.65px;
    text-decoration: none;
  }

  img {
    flex-shrink: 0;
    border-radius: 50%;
    object-fit: cover;
  }

  a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  @media (max-width: 600px) {
    a { gap: 8px; font-size: 18px; }
    img { width: 32px; height: 32px; }
  }

  @media (max-width: 380px) {
    header { padding-inline: 12px; }
    a { gap: 6px; font-size: 16px; }
    img { width: 28px; height: 28px; }
  }
</style>
