---
const options = [
  { label: 'Dark', value: 'dark', path: 'M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z' },
  { label: 'Light', value: 'light', path: 'M12 3v1m0 16v1M3 12h1m16 0h1M5.6 5.6l.7.7m11.4 11.4.7.7M5.6 18.4l.7-.7M17.7 6.3l.7-.7M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z' },
  { label: 'System', value: 'system', path: 'M4 3h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Zm4 18h8m-4-4v4' },
];
---

<div class="theme-menu" data-theme-menu hidden>
  <button class="trigger" type="button" aria-label="Color theme" title="Color theme" aria-haspopup="menu" aria-expanded="false" aria-controls="theme-options">
    <svg aria-hidden="true" viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <path class="sun" d={options[1].path} />
      <path class="moon" d={options[0].path} />
    </svg>
  </button>
  <div class="menu" id="theme-options" role="menu" aria-label="Color theme" hidden>
    {options.map(({ label, value, path }) => (
      <button type="button" role="menuitemradio" aria-checked="false" tabindex="-1" data-theme-value={value}>
        <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={path} /></svg>
        <span>{label}</span>
        <svg class="check" aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 4 4L19 6" /></svg>
      </button>
    ))}
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-theme-menu]').forEach((root) => {
    const trigger = root.querySelector<HTMLButtonElement>('.trigger')!;
    const menu = root.querySelector<HTMLElement>('[role="menu"]')!;
    const items = Array.from(menu.querySelectorAll<HTMLButtonElement>('[data-theme-value]'));

    const sync = () => {
      const theme = document.documentElement.dataset.theme || 'system';
      items.forEach((item) => item.setAttribute('aria-checked', String(item.dataset.themeValue === theme)));
      const label = `Color theme: ${theme}`;
      trigger.setAttribute('aria-label', label);
      trigger.title = label;
    };
    const close = (restoreFocus = false) => {
      menu.hidden = true;
      trigger.setAttribute('aria-expanded', 'false');
      if (restoreFocus) trigger.focus();
    };
    const open = (last = false) => {
      menu.hidden = false;
      trigger.setAttribute('aria-expanded', 'true');
      const selected = items.find((item) => item.getAttribute('aria-checked') === 'true');
      (last ? items[items.length - 1] : selected || items[0]).focus();
    };

    trigger.addEventListener('click', () => menu.hidden ? open() : close());
    trigger.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
        event.preventDefault();
        event.stopPropagation();
        open(event.key === 'ArrowUp');
      }
    });
    items.forEach((item) => item.addEventListener('click', () => {
      document.dispatchEvent(new CustomEvent('theme-preference', { detail: item.dataset.themeValue }));
      close(true);
    }));
    root.addEventListener('keydown', (event) => {
      if (menu.hidden) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        close(true);
      } else if (['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) {
        event.preventDefault();
        const index = items.indexOf(document.activeElement as HTMLButtonElement);
        const next = event.key === 'Home' ? 0 : event.key === 'End' ? items.length - 1
          : (index + (event.key === 'ArrowDown' ? 1 : -1) + items.length) % items.length;
        items[next].focus();
      }
    });
    root.addEventListener('focusout', (event) => {
      if (!root.contains(event.relatedTarget as Node | null)) close();
    });
    document.addEventListener('pointerdown', (event) => {
      if (!root.contains(event.target as Node)) close();
    });
    document.addEventListener('themechange', sync);
    sync();
    root.hidden = false;
  });
</script>

<style>
  .theme-menu { position: relative; flex-shrink: 0; }
  button { color: var(--color-muted); background: transparent; border: 0; border-radius: 6px; cursor: pointer; font: inherit; }
  button:hover, button:focus-visible { background: var(--color-hover); color: var(--color-text); }
  button:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
  .trigger { display: flex; align-items: center; justify-content: center; width: 40px; height: 44px; padding: 0; }
  .moon { display: none; }
  :global(:root[data-theme='dark']) .sun { display: none; }
  :global(:root[data-theme='dark']) .moon { display: initial; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light']):not([data-theme='dark'])) .sun { display: none; }
    :global(:root:not([data-theme='light']):not([data-theme='dark'])) .moon { display: initial; }
  }
  .menu { position: absolute; z-index: 10; top: calc(100% + 6px); right: 0; width: 152px; padding: 4px; border: 1px solid var(--color-border); border-radius: 10px; background: var(--color-background); box-shadow: 0 6px 24px rgb(0 0 0 / 12%); }
  .menu button { display: flex; align-items: center; gap: 10px; width: 100%; min-height: 40px; padding: 0 10px; font-size: 14px; text-align: left; }
  .menu button[aria-checked='true'] { color: var(--color-text); }
  .check { margin-left: auto; visibility: hidden; }
  [aria-checked='true'] .check { visibility: visible; }
  @media (max-width: 600px) { .trigger { width: 32px; } }
</style>
