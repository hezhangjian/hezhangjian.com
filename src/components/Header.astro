---
import SocialLinks from './SocialLinks.astro';
import ThemeMenu from './ThemeMenu.astro';
---

<header>
  <a href="/">
    <img src="/images/avatar.png" alt="" width="40" height="40" />
    <span>Zhangjian He</span>
  </a>
  <div class="actions">
    <SocialLinks />
    <span class="separator" aria-hidden="true"></span>
    <ThemeMenu />
  </div>
</header>

<style>
  header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    min-height: 80px;
    padding: 12px clamp(20px, 4.5vw, 72px);
    box-sizing: border-box;
    border-bottom: 1px solid var(--color-border);
  }

  .actions { display: flex; align-items: center; gap: 12px; margin-left: auto; }

  .separator { width: 1px; height: 24px; flex-shrink: 0; background: var(--color-muted); opacity: 0.6; }

  a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: inherit;
    font-size: 21px;
    font-weight: 700;
    letter-spacing: -0.65px;
    text-decoration: none;
  }

  img {
    flex-shrink: 0;
    border-radius: 50%;
    object-fit: cover;
  }

  a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  @media (max-width: 600px) {
    a { gap: 8px; font-size: 18px; }
    img { width: 32px; height: 32px; }
  }

  @media (max-width: 380px) {
    header { padding-inline: 12px; }
    a { gap: 6px; font-size: 16px; }
    img { width: 28px; height: 28px; }
  }
</style>
